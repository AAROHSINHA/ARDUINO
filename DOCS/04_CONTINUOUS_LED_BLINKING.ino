void setup() {
  // for red led - pin 8 is used
  pinMode(8, OUTPUT); // parameters - [what pin we are working with, whether that pin is input or output]
  // for green led - pin 9 is used
  pinMode(9, OUTPUT);
  // for blue led - pin 10 is used
  pinMode(10, OUTPUT);
}

void loop() {
  // for red - 5 times blink
  digitalWrite(8, HIGH);
  delay(100);
  digitalWrite(8, LOW);
  delay(100);
  digitalWrite(8, HIGH);
  delay(100);
  digitalWrite(8, LOW);
  delay(100);
  digitalWrite(8, HIGH);
  delay(100);
  digitalWrite(8, LOW);
  delay(100);
  digitalWrite(8, HIGH);
  delay(100);
  digitalWrite(8, LOW);
  delay(100);
  digitalWrite(8, HIGH);
  delay(100);
  digitalWrite(8, LOW);
  delay(100);
  
  // for green - 10 times blink
